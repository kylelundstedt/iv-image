#!/bin/bash
# ts-bootstrap — Tailscale bootstrap for iv-image VMs.
# Called at first boot by exe-setup.service (via /exe.dev/setup).
# Uses only exe.dev-internal DNS (tailscale-api.int.exe.xyz) — no external deps.
# Runs as user exedev (exe-setup.service sets User=exedev), so sudo is needed
# for tailscale commands.
set -e

PROXY=https://tailscale-api.int.exe.xyz
TS_HOSTNAME=$(hostname)

# Wait for the proxy to be reachable (network may not be up yet at boot)
for i in $(seq 1 30); do
  curl -sfo /dev/null --connect-timeout 2 "$PROXY/api/v2/tailnet/-/devices" && break
  sleep 1
done

# Delete stale Tailscale nodes with this hostname (prevents -2 suffix on rebuild)
for did in $(curl -sL "$PROXY/api/v2/tailnet/-/devices" \
  | jq -r --arg h "$TS_HOSTNAME" '.devices[] | select(.hostname == $h) | .id'); do
  curl -sL -X DELETE "$PROXY/api/v2/device/$did" >/dev/null
done

# Generate single-use ephemeral auth key (tag:dev grants tailnet access)
TS_AUTHKEY=$(curl -sL -X POST "$PROXY/api/v2/tailnet/-/keys" \
  -H "Content-Type: application/json" \
  -d '{"capabilities":{"devices":{"create":{"reusable":false,"ephemeral":true,"preauthorized":true,"tags":["tag:dev"]}}}}' \
  | jq -r '.key')

if [ -z "$TS_AUTHKEY" ] || [ "$TS_AUTHKEY" = "null" ]; then
  echo "ts-bootstrap: failed to generate auth key from $PROXY" >&2
  exit 1
fi

# Wait for tailscaled socket (systemd starts it; may not be ready yet).
# Don't use `tailscale status` — it fails until tailscaled finishes its
# log.tailscale.com bootstrap, which needs external DNS (~30s on first boot).
# The local API socket appears as soon as tailscaled is ready for commands.
for i in $(seq 1 30); do
  [ -S /var/run/tailscale/tailscaled.sock ] && break
  sleep 1
done

# Authenticate
sudo tailscale up --ssh --accept-dns --hostname="$TS_HOSTNAME" --authkey="$TS_AUTHKEY"
