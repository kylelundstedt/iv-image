# IV overlay on top of the pinned exeuntu base. Built by build.sh.
# BASE defaults to the on-registry tag; build.sh overrides it for other builders.
ARG BASE=localhost:5000/exeuntu-base:d20aa680543e
FROM ${BASE}

# DuckDB CLI (pinned)
RUN curl -fsSL https://github.com/duckdb/duckdb/releases/download/v1.5.3/duckdb_cli-linux-amd64.zip -o /tmp/duckdb.zip \
 && unzip -o /tmp/duckdb.zip -d /usr/local/bin \
 && rm /tmp/duckdb.zip \
 && /usr/local/bin/duckdb --version

# Quarto CLI (pinned) — renders each doc-site repo to its VM HTTP endpoint.
# Tarball bundles pandoc + deno; plain markdown render needs no R/Python.
ARG QUARTO_VERSION=1.9.38
RUN curl -fsSL https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.tar.gz -o /tmp/quarto.tar.gz \
 && mkdir -p /opt/quarto \
 && tar -xzf /tmp/quarto.tar.gz -C /opt/quarto --strip-components=1 \
 && ln -sf /opt/quarto/bin/quarto /usr/local/bin/quarto \
 && rm /tmp/quarto.tar.gz \
 && /usr/local/bin/quarto --version

# Doc-site render+serve tooling — every repo-VM renders its repo to :8000.
# gen-llms-txt is the agent-twin half: a Quarto post-render hook that emits
# .md twins + llms.txt + llms-full.txt next to the rendered HTML.
COPY bin/render-site bin/provision-docsite bin/gen-llms-txt /usr/local/bin/
RUN chmod +x /usr/local/bin/render-site /usr/local/bin/provision-docsite /usr/local/bin/gen-llms-txt

# Tailscale join — owned by the image and started by systemd at boot. It uses
# exe.dev's tailscale-api HTTP proxy integration, so the Tailscale API secret is
# injected on the network and never lands on the VM.
COPY bin/iv-tailscale-join bin/ts-bootstrap /usr/local/bin/
RUN chmod +x /usr/local/bin/iv-tailscale-join /usr/local/bin/ts-bootstrap
COPY systemd/iv-tailscale-join.service /etc/systemd/system/
RUN chmod 644 /etc/systemd/system/iv-tailscale-join.service

# exe.dev BYO-image gotcha: tailscaled.service ships disabled. Enable it so
# tailscaled is running when the join service fires.
RUN systemctl enable tailscaled iv-tailscale-join.service
