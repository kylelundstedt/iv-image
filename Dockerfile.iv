# IV overlay on top of the pinned exeuntu base. Built by build.sh.
# BASE defaults to the on-registry tag; build.sh overrides it for other builders.
ARG BASE=localhost:5000/exeuntu-base:d20aa680543e
FROM ${BASE}

# DuckDB CLI (pinned)
RUN curl -fsSL https://github.com/duckdb/duckdb/releases/download/v1.5.3/duckdb_cli-linux-amd64.zip -o /tmp/duckdb.zip \
 && unzip -o /tmp/duckdb.zip -d /usr/local/bin \
 && rm /tmp/duckdb.zip \
 && /usr/local/bin/duckdb --version

# Quarto CLI (pinned) — renders each doc-site repo to its VM HTTP endpoint.
# Tarball bundles pandoc + deno; plain markdown render needs no R/Python.
ARG QUARTO_VERSION=1.9.38
RUN curl -fsSL https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.tar.gz -o /tmp/quarto.tar.gz \
 && mkdir -p /opt/quarto \
 && tar -xzf /tmp/quarto.tar.gz -C /opt/quarto --strip-components=1 \
 && ln -sf /opt/quarto/bin/quarto /usr/local/bin/quarto \
 && rm /tmp/quarto.tar.gz \
 && /usr/local/bin/quarto --version

# Doc-site render+serve tooling — every repo-VM renders its repo to :8000.
# gen-llms-txt is the agent-twin half: a Quarto post-render hook that emits
# .md twins + llms.txt + llms-full.txt next to the rendered HTML.
COPY bin/render-site bin/provision-docsite bin/gen-llms-txt /usr/local/bin/
RUN chmod +x /usr/local/bin/render-site /usr/local/bin/provision-docsite /usr/local/bin/gen-llms-txt

# exe.dev BYO-image gotcha: tailscaled.service ships disabled. Enable it so the
# daemon is running and idle on boot. The image does NOT auto-join the tailnet:
# there is no baked bootstrap, no setup-script hook, no Tailscale API access on
# the VM. A VM joins on demand via the `join-tailnet` agent skill, which SSHes in
# over *.exe.xyz and runs `tailscale up` (minting a one-use key through the
# exe.dev tailscale-api proxy). See tailnet.md.
RUN systemctl enable tailscaled

# --- Agent configuration (team defaults) ---
# AGENTS.md: team-wide instructions for Claude Code and Codex.
# settings.json: SSH guard hook (blocks parallel SSH to exe.dev) + env.
# MCP servers: exe.dev proxy endpoints (motherduck, github-work).
# Skills: pre-installed so VMs start ready — no npm install on first launch.
#
# Personal dotfiles layer on top: a user's install.sh can overlay AGENTS.md,
# add personal MCP servers, and install additional skills.
COPY agent/AGENTS.md /home/exedev/.agents/AGENTS.md
COPY agent/settings.json /home/exedev/.claude/settings.json
RUN mkdir -p /home/exedev/.claude /home/exedev/.codex \
 && ln -sf ../.agents/AGENTS.md /home/exedev/.claude/CLAUDE.md \
 && ln -sf ../.agents/AGENTS.md /home/exedev/.codex/AGENTS.md \
 && chown -R exedev:exedev /home/exedev/.agents /home/exedev/.claude /home/exedev/.codex

# MCP server pre-registration (writes ~/.claude.json)
COPY agent/setup-mcp.sh /tmp/setup-mcp.sh
RUN chmod +x /tmp/setup-mcp.sh && su exedev -c /tmp/setup-mcp.sh && rm /tmp/setup-mcp.sh

# Skills (npm installs cached in image layer — slow but only runs at build time)
COPY agent/setup-skills.sh /tmp/setup-skills.sh
RUN chmod +x /tmp/setup-skills.sh && su exedev -c /tmp/setup-skills.sh && rm /tmp/setup-skills.sh
