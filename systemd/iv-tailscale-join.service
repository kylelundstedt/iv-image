[Unit]
Description=Join the IV Tailscale tailnet
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service
ConditionPathExists=!/etc/iv-image/disable-tailscale-join
StartLimitIntervalSec=10min
StartLimitBurst=30

[Service]
Type=oneshot
ExecStart=/usr/local/bin/iv-tailscale-join
RemainAfterExit=yes
Restart=on-failure
RestartSec=10s
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
