{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/render-before-push.sh",
            "if": "Bash(git push*)",
            "timeout": 120,
            "statusMessage": "Rendering site before push"
          }
        ]
      }
    ]
  }
}
